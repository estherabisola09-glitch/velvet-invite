# Server Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Connection (Atlas or local)
# Set your real connection string here:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=velvet_invite

# Auth & Security
JWT_SECRET=development_jwt_secret_key_velvet_invite_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Provider (Anthropic Claude default per TRD §2.4)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Alternate AI Provider (for future flexibility)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Cloudinary (Media / Photo uploads per TRD §1)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
